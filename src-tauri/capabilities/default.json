{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Окна оболочки: показать/спрятать поповеры, поставить flyout над доком",
  "windows": [
    "launcher",
    "category",
    "dock",
    "dock-backdrop",
    "flyout",
    "search",
    "spike-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-set-position",
    "core:window:allow-set-size"
  ]
}
