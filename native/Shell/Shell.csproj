<Project Sdk="Microsoft.NET.Sdk">
  <!-- Оболочка на WinUI 3 (WSH-E13 прототип, WSH-E14 переезд). Интерфейс собирается кодом, без .xaml. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>WindowsShell</RootNamespace>
    <AssemblyName>WindowsShellNative</AssemblyName>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <WindowsPackageType>None</WindowsPackageType>
    <!-- Без .xaml файлов PRI приложения не собирается, и XamlControlsResources не находит
         themeresources.xaml. Этот флаг собирает WindowsShellNative.pri всегда. -->
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultApplicationDefinition>false</EnableDefaultApplicationDefinition>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>shell.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Предупреждения interop-генератора про [DllImport] нам не мешают. -->
    <NoWarn>$(NoWarn);SYSLIB1054;CA1416</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <!-- Значок в трее берётся из файла рядом с exe. -->
    <Content Include="shell.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Sounds\*.mp3" CopyToOutputDirectory="PreserveNewest" />
    <!-- FPS: Intel PresentMon (MIT), скачивается при сборке, сверяется по SHA-256. -->
    <Content Include="$(PresentMonExe)" Link="Tools\PresentMon.exe" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <PropertyGroup>
    <PresentMonVersion>2.3.1</PresentMonVersion>
    <PresentMonSha256>364E5D98D4D134BD54DD25C22ED2CA2F4883F8BC3ED6502BEE0C151E3436D30C</PresentMonSha256>
    <PresentMonDir>$(MSBuildProjectDirectory)\obj\tools\PresentMon-$(PresentMonVersion)</PresentMonDir>
    <PresentMonExe>$(PresentMonDir)\PresentMon.exe</PresentMonExe>
  </PropertyGroup>
  <Target Name="FetchPresentMon" BeforeTargets="BeforeBuild;AssignTargetPaths" Condition="!Exists('$(PresentMonExe)')">
    <DownloadFile SourceUrl="https://github.com/GameTechDev/PresentMon/releases/download/v$(PresentMonVersion)/PresentMon-$(PresentMonVersion)-x64.exe"
                  DestinationFolder="$(PresentMonDir)" DestinationFileName="PresentMon.download" Retries="3" />
    <VerifyFileHash File="$(PresentMonDir)\PresentMon.download" Hash="$(PresentMonSha256)" Algorithm="SHA256" />
    <Move SourceFiles="$(PresentMonDir)\PresentMon.download" DestinationFiles="$(PresentMonExe)" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260921001" />
    <PackageReference Include="WinUIEx" Version="2.9.3" />
    <!-- Поиск файлов в Пуске: индекс Windows Search через OLE DB. -->
    <PackageReference Include="System.Data.OleDb" Version="8.0.1" />
    <!-- Сторож: где стоял каждый поток зависшей оболочки (отчёт о сбое). -->
    <PackageReference Include="Microsoft.Diagnostics.Runtime" Version="3.1.512801" />
    <!-- Снимки: обрезка, PNG, рисование поверх в редакторе (GDI+). -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.10" />
  </ItemGroup>
</Project>
